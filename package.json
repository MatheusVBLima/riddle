{
  "name": "riddle",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "assets:audio": "bun scripts/generate-audio.ts",
    "assets:puzzles": "bun scripts/generate-puzzle-assets.ts",
    "assets:archive": "bun --conditions=react-server scripts/generate-archive-assets.ts",
    "assets:attic": "bun scripts/generate-attic-assets.ts",
    "assets:notebook": "bun scripts/generate-notebook-pages.ts",
